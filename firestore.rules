rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Users Collection (Admin, Teacher, Student accounts)
    match /users/{userId} {
      allow read, write: if true;
    }

    // Admins Collection
    match /admins/{adminId} {
      allow read, write: if true;
    }

    // Classes Collection (Rombongan Belajar)
    match /classes/{classId} {
      allow read, write: if true;
    }

    // Questions Collection (Bank Soal CBT)
    match /questions/{questionId} {
      allow read, write: if true;
    }

    // Exams Collection (Paket Ujian CBT)
    match /exams/{examId} {
      allow read, write: if true;
    }

    // Exam Sessions Collection (Real-time Telemetry & State)
    match /exam_sessions/{sessionId} {
      allow read, write: if true;
    }

    // Exam Results Collection (Nilai & Evaluasi AI)
    match /exam_results/{resultId} {
      allow read, write: if true;
    }

    // System Taxonomy Collection (Mata Pelajaran, Bab, Sub-bab, IPK)
    match /taxonomy/{docId} {
      allow read, write: if true;
    }

    // Connection Test
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
