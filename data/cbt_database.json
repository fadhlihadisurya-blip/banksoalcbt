          "text": "W = P · ΔV"
        },
        {
          "id": "B",
          "text": "W = 0"
        },
        {
          "id": "C",
          "text": "W = n · R · T · ln(V2/V1)"
        },
        {
          "id": "D",
          "text": "W = Q - ΔU"
        },
        {
          "id": "E",
          "text": "W = Tak hingga"
        }
